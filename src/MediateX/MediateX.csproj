<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <Features>strict</Features>
    <NoWarn>$(NoWarn);CS1701;CS1702;CS1591</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Package Identity -->
    <PackageId>MediateX</PackageId>
    <Version>3.3.1</Version>
    <AssemblyVersion>3.3.1</AssemblyVersion>
    <FileVersion>3.3.1</FileVersion>
    <Product>MediateX</Product>

    <!-- Package Metadata -->
    <Title>MediateX - Modern Mediator for .NET</Title>
    <Authors>jorg3roch4</Authors>
    <Description>Modern mediator implementation for .NET 10+ with in-process messaging. Supports request/response, CQRS, notifications, and events. Based on MediatR 12.5.0.</Description>
    <Copyright>Copyright (c) 2025 jorg3roch4. Based on MediatR by Jimmy Bogard.</Copyright>
    <PackageTags>mediator;request;response;queries;commands;notifications;mediatex;cqrs;events;messaging;pipeline;net10</PackageTags>
    <PackageProjectUrl>https://github.com/jorg3roch4/MediateX</PackageProjectUrl>
    <PackageIcon>icon-128x128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReleaseNotes>v3.3.1 - Repository cleanup: removed abandoned MediateX.SourceGenerator spike project, its sample, and related research/spec notes. No runtime change vs v3.3.0.</PackageReleaseNotes>
    <NeutralLanguage>en</NeutralLanguage>
    <MinClientVersion>6.0</MinClientVersion>

    <!-- Repository Information -->
    <RepositoryUrl>https://github.com/jorg3roch4/MediateX</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>false</PublishRepositoryUrl>

    <!-- Package Validation -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>3.2.0</PackageValidationBaselineVersion>

    <!-- Documentation and Symbols -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>false</IncludeSymbols>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>

    <!-- Build Configuration -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Package Output -->
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts</PackageOutputPath>

  </PropertyGroup>

  <!-- Expose internals to test and benchmark projects -->
  <ItemGroup>
    <InternalsVisibleTo Include="MediateX.Tests" />
    <InternalsVisibleTo Include="MediateX.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\assets\icon-128x128.png" Pack="true" PackagePath="" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\README.md" />
  </ItemGroup>

</Project>
